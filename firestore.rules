rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Portal Educacional SENAI - Regras de Segurança do Cloud Firestore
     * Ambiente: Produção Permanente (Alta Segurança - sem prazo de expiração)
     * Autenticação Docente: Exclusiva via Firebase Auth / Google Auth (williamdevide@gmail.com)
     */

    // Função que valida se o usuário solicitante é o Professor William autenticado via Firebase Auth
    function isProfessor() {
      return request.auth != null 
        && request.auth.token.email != null 
        && request.auth.token.email.lower() == 'williamdevide@gmail.com';
    }

    // Função validadora de schema para a coleção de configurações de agendamento de TCC
    function isValidConfigTcc(data) {
      return data.keys().hasOnly(['liberado', 'agendamento_liberado', 'atualizado_em', 'modificado_por'])
        && (!('liberado' in data) || data.liberado is bool)
        && (!('agendamento_liberado' in data) || data.agendamento_liberado is bool)
        && (!('atualizado_em' in data) || (data.atualizado_em is string && data.atualizado_em.size() <= 50))
        && (!('modificado_por' in data) || (data.modificado_por is string && data.modificado_por.size() <= 50));
    }

    // Função validadora de schema para os agendamentos das bancas de TCC
    function isValidAgendamento(data) {
      return data.keys().hasAll(['turma_id', 'turma_nome', 'grupo_nome', 'data', 'horario'])
        && data.keys().hasOnly(['turma_id', 'turma_nome', 'grupo_nome', 'data', 'horario', 'observacoes', 'criado_em', 'atualizado_em', 'id'])
        && data.turma_id is string && data.turma_id.size() > 0 && data.turma_id.size() <= 100
        && data.turma_nome is string && data.turma_nome.size() > 0 && data.turma_nome.size() <= 100
        && data.grupo_nome is string && data.grupo_nome.size() > 0 && data.grupo_nome.size() <= 150
        && data.data is string && data.data.size() > 0 && data.data.size() <= 50
        && data.horario is string && data.horario.size() > 0 && data.horario.size() <= 30
        && (!('observacoes' in data) || (data.observacoes is string && data.observacoes.size() <= 500))
        && (!('criado_em' in data) || (data.criado_em is string && data.criado_em.size() <= 50))
        && (!('atualizado_em' in data) || (data.atualizado_em is string && data.atualizado_em.size() <= 50))
        && (!('id' in data) || (data.id is string && data.id.size() <= 100));
    }

    // Coleção: config/tcc
    // Gerencia o controle global de liberação/bloqueio dos agendamentos de TCC
    match /config/tcc {
      // Leitura pública para que alunos e professores consultem o status em tempo real
      allow read: if true;

      // Criação ou atualização permitida SOMENTE para o Professor William autenticado, validando o schema
      allow create, update: if isProfessor() && isValidConfigTcc(request.resource.data);

      // Bloqueio total de exclusão do documento de configuração
      allow delete: if false;
    }

    // Coleção: agendamentos/{agendamentoId}
    // Armazena as bancas marcadas pelos alunos para o TCC
    match /agendamentos/{agendamentoId} {
      // Leitura pública para exibição do quadro geral de bancas para alunos e professores
      allow read: if true;

      // Criação de novos agendamentos por alunos com validação estrita de integridade e sanitização
      allow create: if isValidAgendamento(request.resource.data);

      // Edição e exclusão de bancas marcadas permitidas SOMENTE para o Professor William autenticado
      allow update, delete: if isProfessor();
    }

    // Bloqueio padrão de alta segurança: qualquer outra coleção ou rota não mapeada tem acesso negado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
